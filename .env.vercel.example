# Vercel Environment Variables for manyleads.io
# Copy these to your Vercel project settings: Settings > Environment Variables

# =============================================================================
# REQUIRED - Supabase Configuration
# =============================================================================
# Get these from: https://supabase.com/dashboard/project/mffvbluqnfgnthwlavlj/settings/api

# Public Supabase URL (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=https://mffvbluqnfgnthwlavlj.supabase.co

# Public Anon Key (REQUIRED) - Safe to expose in client-side code
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role Key (REQUIRED) - NEVER expose in client-side code!
# This key bypasses RLS and is used for admin operations and dashboard stats
# ⚠️ CRITICAL: Keep this secret! Only use on server-side.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# OPTIONAL - Lead Scraping (Apify Integration)
# =============================================================================
# Get your API token from: https://console.apify.com/account#/integrations

# Apify API Token (OPTIONAL) - Required for lead scraping functionality
APIFY_API_TOKEN=your_apify_token_here

# Enable Mock Data (OPTIONAL) - Set to true for development/testing without Apify
ENABLE_MOCK_DATA=false

# =============================================================================
# OPTIONAL - Payment Processing (Stripe)
# =============================================================================
# Get these from: https://dashboard.stripe.com/apikeys

# Stripe Secret Key (OPTIONAL) - Required for payment processing
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Stripe Publishable Key (OPTIONAL) - Safe to expose in client-side code
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Stripe Webhook Secret (OPTIONAL) - For webhook signature verification
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# =============================================================================
# OPTIONAL - OAuth Providers
# =============================================================================

# Google OAuth (OPTIONAL)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth (OPTIONAL)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# =============================================================================
# NOTES
# =============================================================================
#
# 1. In Vercel Dashboard, add each variable:
#    - Go to: Settings > Environment Variables
#    - Select environments: Production, Preview, Development (as needed)
#    - Click "Add" for each variable
#
# 2. After adding variables, redeploy your application:
#    - Deployments > Latest Deployment > ... > Redeploy
#
# 3. Verify deployment with health check:
#    - Visit: https://your-domain.vercel.app/api/health
#    - Should return: {"status":"ok","serviceClient":"connected"}
#
# 4. Security Best Practices:
#    - NEVER commit .env files to git
#    - Rotate SUPABASE_SERVICE_ROLE_KEY if exposed
#    - Use different keys for Production vs Preview environments
#
# =============================================================================
