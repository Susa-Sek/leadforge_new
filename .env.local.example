# ============================================
# Manyleads.io - Environment Variables
# ============================================

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/mffvbluqnfgnthwlavlj/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://mffvbluqnfgnthwlavlj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google OAuth (Optional - for PROJ-6 Google Login)
# Get from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================
# APIFY CONFIGURATION (Required for PROJ-12/13)
# ============================================
# Get from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# Webhook Secret for signature validation (optional)
APIFY_WEBHOOK_SECRET=your_webhook_secret_here

# Actor Configuration
APIFY_PRIMARY_ACTOR=compass/crawler-google-places
APIFY_FALLBACK_ACTOR=scraper-mind/google-maps-email-scraper-unlimited
APIFY_ENRICHMENT_ACTOR=vdrmota/contact-info-scraper

# Mock Data for Development (set to true when APIFY_API_TOKEN is not available)
ENABLE_MOCK_DATA=false

# ============================================
# SEARCH CONFIGURATION (Optional)
# ============================================
# Default search limits
DEFAULT_MAX_RESULTS=50
MAX_SEARCH_TIMEOUT_MINUTES=5
CACHE_DURATION_HOURS=24

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10

# Outscraper as alternative (optional)
# OUTSCRAPER_API_KEY=your_outscraper_key_here

# ============================================
# STRIPE CONFIGURATION (Optional - for PROJ-22-24 Payments)
# ============================================
# Get from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# SENTRY (Optional - for Error Tracking)
# ============================================
# Get from: https://sentry.io/settings/projects/
# SENTRY_DSN=https://xxx@sentry.io/xxx
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
